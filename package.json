{
  "name": "peopletb",
  "productName": "PeopleTB",
  "version": "1.2.0",
  "description": "PeopleTB",
  "main": "src/main.js",
  "author": "PeopleTB",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.taskbarjack.app",
    "productName": "PeopleTB",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "overheat.config.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "legalTrademarks": "PeopleTB",
      "artifactName": "PeopleTB-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "PeopleTB"
    }
  }
}
